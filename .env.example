# Copy this file to .env.local and fill in your own values.
#   cp .env.example .env.local
# .env.local is gitignored — NEVER commit real credentials to GitHub.

# MongoDB Atlas connection string (Database -> Connect -> Drivers)
# Local dev: .env.local
# Vercel:    Project -> Settings -> Environment Variables
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Optional: protects GET /api/enquiries (send as `x-admin-token` header)
ADMIN_TOKEN=

# JWT Secret for customer & admin authentication (generate a strong random secret)
JWT_SECRET=your-random-jwt-secret-key-change-in-production

# Seed Admin credentials (used only by `npm run seed:admin` for initial setup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_NAME=Fleet Administrator
ADMIN_PHONE=9800000000

# Optional: override the port used by `npm run dev:api`
PORT=5000

# ---------------------------------------------------------------------------
# SMTP Email Service Configuration
# Used to send automated notifications on order status changes (Confirmed, Shipped, Delivered)
# For Gmail: Use smtp.gmail.com:587 with an App Password (https://myaccount.google.com/apppasswords)
# For SendGrid/Mailtrap/Brevo: Use their host, port (587) and API key/credentials
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM="Jammu Makrana Transport" <your-email@example.com>
SITE_URL=https://jammumakranatransport-theta.vercel.app
