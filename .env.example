# Copy this file to .env.local and fill in your own values.
#   cp .env.example .env.local
# .env.local is gitignored — never put real credentials in THIS file.

# MongoDB Atlas connection string (Database -> Connect -> Drivers)
# Local dev: .env.local
# Vercel:    Project -> Settings -> Environment Variables
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Optional: protects GET /api/enquiries (send as `x-admin-token` header)
ADMIN_TOKEN=

# JWT Secret for customer & admin authentication
JWT_SECRET=makrana-transport-jwt-secret-key-change-in-production

# Seed Admin credentials (used by `npm run seed:admin`)
ADMIN_EMAIL=admin@jmtransport.com
ADMIN_PASSWORD=Admin@1985
ADMIN_NAME=Ramakishan Prajapat (Admin)
ADMIN_PHONE=9829575967

# Optional: override the port used by `npm run dev:api`
PORT=5000

# ---------------------------------------------------------------------------
# SMTP Email Service Configuration
# Used to send automated notifications on order status changes (Confirmed, Shipped, Delivered)
# For Gmail: Use smtp.gmail.com:587 with an App Password (https://myaccount.google.com/apppasswords)
# For SendGrid/Mailtrap/Brevo: Use their host, port (587) and API key/credentials
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=harshitverma2901@gmail.com
SMTP_PASS=your-gmail-16-character-app-password
EMAIL_FROM="Jammu Makrana Transport" <harshitverma2901@gmail.com>
SITE_URL=https://jammumakranatransport-theta.vercel.app
